/*
 * protein_novelty profile: Stage 3 (in progress -- see protein_novelty.nf and
 * README.md for what's wired vs. still to build).
 *
 * SAFETY DEFAULT: uniprot_test_records defaults to a small number, NOT 0
 * (0 = unbounded full fungi pull). Override explicitly with
 * `--uniprot_test_records 0` only when you actually intend the full pull --
 * do not flip this default casually.
 */

workDir = "${launchDir}/work/protein_novelty"

params {
    outdir              = "${launchDir}/results/protein_novelty"
    refdb_outdir        = "${launchDir}/results/protein_novelty/refdb"
    uniprot_staging_dir = "${launchDir}/lib/uniprot_fungi"   // matches Fungi_BFD/nextflow's lib/swissprot staging convention

    fungi_taxid           = 4751    // NCBI Taxonomy id for Fungi
    uniprot_test_records  = 20      // SAFETY DEFAULT (REST smoke-test path only) — see header comment above

    // MMSEQS_LINCLUST: identity/coverage per the design doc's Step 2
    // (~90-95% identity dereplication threshold). Container confirmed already
    // cached on this cluster (2026-09-06) — not built for this project.
    mmseqs2_container = "${params.singularity_cache}/depot.galaxyproject.org-singularity-mmseqs2-17.b804f--hd6d6fdc_1.img"
    mmseqs_min_seq_id = 0.95
    mmseqs_coverage   = 0.90
    mmseqs_cov_mode   = 0

    // Already-staged, taxonomy-aware DIAMOND db (see modules/search/
    // DIAMOND_NOVELTY_SCREEN) — not yet wired into this workflow.
    nr_cluster_dmnd      = '/srv/projects/db/ncbi/diamond/20260128/nr_cluster_seq.dmnd'
    diamond_evalue       = 1e-5
    diamond_sensitivity  = 'sensitive'
    diamond_max_targets  = 10
}

apptainer.enabled   = true
singularity.enabled = false
apptainer.runOptions = "--bind ${projectDir.toRealPath()} \${SCRATCH:+--bind \$SCRATCH:\$SCRATCH} --bind /srv/projects/db:/srv/projects/db"

process {
    withLabel: 'fetch_uniprot' {
        // `short` caps at 2h -- confirmed live 2026-09-06 that requesting 4h
        // here made sbatch reject the submission outright ("Requested time
        // limit is invalid"), not just queue/fail. This label only ever runs
        // the small REST smoke test (seconds), so 2h is ample headroom.
        cpus   = 1
        memory = '2 GB'
        time   = '2 h'
        queue  = 'short'
    }

    withLabel: 'fetch_uniprot_ftp' {
        cpus   = 1
        memory = '4 GB'
        // uniprot_trembl_fungi.dat.gz is ~13 GB -- 6h per user request
        // (2026-09-07); -C - (resume) makes a retry cheap if that's not
        // enough for a slow/throttled connection. queue='batch' also per
        // user request for the download step.
        time   = '6 h'
        queue  = 'batch'
    }

    withLabel: 'convert_dat' {
        // Streaming parse (Bio.SwissProt.parse is a generator, not a
        // whole-file load) -- memory stays modest even for the 13 GB trembl
        // file; time is dominated by parsing ~17.5M records.
        cpus   = 1
        memory = '16 GB'
        time   = '24 h'
        queue  = 'epyc'
    }

    withLabel: 'combine_uniprot' {
        // same `short` 2h-cap fix as 'fetch_uniprot' above
        cpus   = 1
        memory = '4 GB'
        time   = '2 h'
        queue  = 'short'
    }

    withLabel: 'mmseqs_linclust' {
        // highmem caps at 32 cpus except for one exception node -- epyc goes
        // to 64 cpus but highmem is where the 256GB memory actually lives, so
        // stay on highmem and drop cpus to 32 rather than move queues.
        container = params.mmseqs2_container
        cpus      = 32
        memory    = '256 GB'   // ~17.5M sequences; linclust memory scales with
                                // total residues + k-mer index, not just seq count
        time      = '48 h'
        queue     = 'highmem'
    }

    withLabel: 'diamond' {
        cpus   = 32
        memory = '64 GB'   // nr_cluster_seq.dmnd is ~195 GB on disk; needs real RAM headroom
        time   = '24 h'
        queue  = 'epyc'
    }
}
