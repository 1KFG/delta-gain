/*
 * Test / stub profile for genome_classify.nf. Run with:
 *   nextflow run genome_classify.nf -profile test -stub-run --n_test 2
 *
 * Exercises the channel/graph wiring fast: tiny synthetic genomes, executor
 * forced local, no container loading (beforeScript = ':').
 */

params {
    samples    = "${projectDir}/tests/data/test_samples.csv"
    genome_dir = "${projectDir}/tests/data/genomes"
    outdir     = "${projectDir}/tests/output"
    n_test     = 0

    mash_kmer         = 21
    mash_sketch_size  = 1000
    prefilter_ani     = 80.0
    skani_preset_flag = '--fast'
    skani_min_af      = 15
    ani_cluster_threshold = 95.0
    ani_outlier_threshold = 90.0

    // protein_novelty.nf stub inputs
    refdb_outdir         = "${projectDir}/tests/output/refdb"
    uniprot_staging_dir  = "${projectDir}/tests/output/uniprot_fungi"
    fungi_taxid          = 4751
    uniprot_test_records = 5
    mmseqs_min_seq_id    = 0.95
    mmseqs_coverage      = 0.90
    mmseqs_cov_mode      = 0
}

apptainer.enabled = false

workDir = "${projectDir}/tests/work"

process {
    executor = 'local'

    withLabel: 'mash_sketch'    { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'mash_prefilter' { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'components'     { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'skani'          { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'classify'       { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'fetch_uniprot'     { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'fetch_uniprot_ftp' { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'convert_dat'       { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'combine_uniprot'   { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'mmseqs_linclust'   { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'diamond'           { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
}
