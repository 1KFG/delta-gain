/*
 * Test / stub profile for genome_classify.nf. Run with:
 *   nextflow run genome_classify.nf -profile test -stub-run --n_test 2
 *
 * Exercises the channel/graph wiring fast: tiny synthetic genomes, executor
 * forced local, no container loading (beforeScript = ':').
 */

params {
    samples    = "${projectDir}/tests/data/test_samples.csv"
    genome_dir = "${projectDir}/tests/data/genomes"
    outdir     = "${projectDir}/tests/output"
    n_test     = 0

    mash_kmer         = 21
    mash_sketch_size  = 1000
    prefilter_ani     = 80.0
    skani_preset_flag = '--fast'
    skani_min_af      = 15
    ani_cluster_threshold = 95.0
    ani_outlier_threshold = 90.0

    // protein_novelty.nf stub inputs
    refdb_outdir         = "${projectDir}/tests/output/refdb"
    uniprot_staging_dir  = "${projectDir}/tests/output/uniprot_fungi"
    fungi_taxid          = 4751
    uniprot_test_records = 5
    mmseqs_min_seq_id    = 0.95
    mmseqs_coverage      = 0.90
    mmseqs_cov_mode      = 0
    uniprot_fungi_nr_fasta = ''   // '' here (unlike the real profile config) so -stub-run still exercises the full FTP/convert/combine/linclust graph
    nr_cluster_dmnd      = "${projectDir}/tests/data/refdb/uniprot_fungi_smoketest.fasta"   // stub-run only, never actually searched
    diamond_container    = ''   // apptainer disabled in this profile -- unused
    diamond_evalue       = 1e-5
    diamond_sensitivity  = 'sensitive'
    diamond_max_targets  = 10

    // BFD-side pep extraction stub inputs (BUILD_PEP_MANIFEST/COMBINE_BFD_PROTEINS/SPLIT_FASTA)
    pep_dir            = "${projectDir}/tests/data/pep"
    diamond_chunk_size = 20000

    // DIAMOND_CLUSTER/COMPARE_CLUSTERINGS stub inputs
    diamond_container_2_2_6     = ''   // apptainer disabled in this profile -- unused
    diamond_cluster_approx_id   = 95
    diamond_cluster_mutual_cover = 90

    // BUILD_CLUSTER_INCIDENCE_MATRIX/ACCUMULATION_CURVE stub inputs. Real
    // BFD.duckdb table paths/version tag stay '' by default in
    // nextflow.config (see its comment) -- here they're pointed at tiny
    // placeholder fixtures so -stub-run still exercises the channel/graph
    // wiring (checkIfExists: true on Channel.fromPath needs a real file;
    // -stub-run never reads its content).
    bfd_duckdb_busco_parquet     = "${projectDir}/tests/data/accumulation/busco_genome.parquet"
    bfd_duckdb_asm_stats_parquet = "${projectDir}/tests/data/accumulation/asm_stats.parquet"
    genome_classification_tsv    = "${projectDir}/tests/data/accumulation/genome_classification.tsv"
    bfd_version_tag              = 'stub-test'
    n_permutations                = 10
    min_clade_n                   = 2
    python_container   = ''   // apptainer disabled in this profile -- unused
    python_pip_cache   = ''   // no PYTHONPATH prepend when empty -- unused in this profile
}

apptainer.enabled = false

workDir = "${projectDir}/tests/work"

process {
    executor = 'local'

    withLabel: 'mash_sketch'    { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'mash_prefilter' { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'components'     { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'skani'          { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'classify'       { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'fetch_uniprot'     { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'fetch_uniprot_ftp' { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'convert_dat'       { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'combine_uniprot'   { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'mmseqs_linclust'   { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'diamond'           { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'build_pep_manifest'   { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'combine_bfd_proteins' { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'split_fasta'          { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'diamond_makedb'       { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'bin_novelty_hits'     { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'diamond_cluster'      { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'extract_cluster_reps' { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'compare_clusterings'  { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'build_cluster_incidence_matrix' { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'accumulation_curve'             { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withName: 'MMSEQS_LINCLUST_BFD'     { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
    withName: 'MMSEQS_LINCLUST_UNIPROT' { cpus = 1; memory = '1 GB'; time = '10m'; queue = 'short'; beforeScript = ':' }
}
