/*
 * Nextflow configuration for DeltaGain (pipeline code only — see README.md
 * for the split from DeltaGain_Fungi, the project-instance repo).
 *
 * This repo defines the workflow logic and its generic pipeline-validation
 * profile (`test`/`stub`, below) only. The real per-project run configs
 * (`profile_genome_classify.config`, `profile_protein_novelty.config` — real
 * data paths, real resource requests) now live in DeltaGain_Fungi and are
 * loaded via an explicit `-c` flag from that repo's launch scripts, e.g.:
 *
 *   nextflow run <path-to-DeltaGain>/genome_classify.nf \
 *       -c conf/profile_genome_classify.config -resume
 *
 * (run from within a DeltaGain_Fungi checkout — see its run_*.sh scripts).
 * No `-profile` name is needed for that: `-c` merges the file directly
 * regardless of whether it's wrapped in a `profiles{}` block, and these
 * project confs are bare bodies, not wrapped — see DeltaGain_Fungi's
 * conf/profile_*.config files.
 *
 * Why not keep includeConfig'ing them from here: `includeConfig` paths are
 * relative to THIS file's location, so pointing at a sibling repo would
 * only work in this exact local layout and would break
 * `nextflow run 1KFG/delta-gain` for anyone without that same sibling
 * checkout. Passing the project's conf via `-c` at launch time avoids that
 * coupling entirely.
 *
 * See DeltaGain/README.md and
 * /bigdata/stajichlab/shared/projects/BFD/Ideas/protein_novelty_esm2_plan.md
 * for the full design.
 */

manifest {
    name            = 'DeltaGain'
    description     = 'Quantifying the annotation/novelty yield of large-scale fungal genome sequencing'
    mainScript      = 'genome_classify.nf'
    nextflowVersion = '>=25.10'
}

params {
    samples             = "${launchDir}/samples.csv"
    n_test              = 0
    outdir              = "${launchDir}/results"
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH_mm_ss')

    // Shared container cache dir — same convention as Fungi_BFD/nextflow:
    // resolved from the environment, no hardcoded /bigdata path. run_*.sh
    // launchers export one of these; interactive runs must too.
    singularity_cache = [
        System.getenv('NXF_APPTAINER_CACHEDIR'),
        System.getenv('NXF_SINGULARITY_CACHEDIR'),
        System.getenv('APPTAINER_CACHEDIR'),
        System.getenv('SINGULARITY_CACHEDIR')
    ].find { it }
}

executor {
    name            = 'slurm'
    queueSize       = 500
    submitRateLimit = '400/1min'
    pollInterval    = '1 min'
    exitReadTimeout = '20 min'
}

process {
    // See Fungi_BFD/nextflow/nextflow.config's process.shell comment: login
    // shell is required for `module` to be defined, but its startup chain
    // rebuilds PATH from a fixed baseline -- bin/ helpers must be called by
    // absolute path (${projectDir}/bin/...), never bare name.
    shell          = ['/bin/bash', '-l']
    errorStrategy  = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries     = 2
    cache          = 'lenient'
    // Clear SCRATCH/TMPDIR so each task gets its OWN node's values rather than
    // inheriting whatever the launching session's node had (see Fungi_BFD/
    // nextflow/nextflow.config for the incident this fixes).
    clusterOptions = '-N 1 -n 1 --export=ALL,SCRATCH=,TMPDIR='
}

apptainer {
    enabled      = false
    autoMounts   = true
    cacheDir     = params.singularity_cache
    envWhitelist = 'SCRATCH'
}

singularity {
    enabled      = false
    autoMounts   = true
    cacheDir     = params.singularity_cache
    envWhitelist = 'SCRATCH'
}

profiles {
    // Pipeline-validation only — see this file's header comment for how real
    // (project-instance) run configs are loaded instead (via `-c`, from
    // DeltaGain_Fungi).
    test { includeConfig 'conf/test.config' }
    stub {
        includeConfig 'conf/test.config'
        params.n_test = 2
    }
}
